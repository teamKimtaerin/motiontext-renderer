{
  "name": "cwi-bouncing",
  "version": "2.0.0",
  "type": "hybrid",
  "pluginApi": "3.0",
  "minRenderer": "2.0.0",
  "entry": "index.mjs",
  "targets": ["text"],
  "capabilities": ["style-vars", "dom-manipulation"],
  "preload": [],
  "timeOffset": [-0.1, 0.1],
  "schema": {
    "waveHeight": {
      "type": "number",
      "default": 12,
      "min": 0,
      "max": 60,
      "step": 1,
      "ui": { "control": "slider", "unit": "px", "allowDefine": true },
      "i18n": {
        "label": { "ko": "바운스 높이", "en": "Bounce Height" },
        "description": { "ko": "바운싱할 때 위아래 이동하는 최대 픽셀 높이", "en": "Maximum vertical bouncing offset in pixels" }
      }
    },
    "letterDuration": {
      "type": "number",
      "default": 0.6,
      "min": 0.2,
      "max": 0.9,
      "step": 0.1,
      "ui": { "control": "slider", "allowDefine": true },
      "i18n": {
        "label": { "ko": "글자 지속시간", "en": "Letter Duration" },
        "description": { "ko": "각 글자별 바운싱 애니메이션 지속 비율", "en": "Animation duration ratio for each letter" }
      }
    }
  }
}
